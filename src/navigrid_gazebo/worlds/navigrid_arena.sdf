<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="navigrid_arena">
    <!-- Physics Configuration -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Essential Simulation Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Ambient Lighting & Sun -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 30 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane (30m x 30m Arena Floor) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="floor_link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.82 1</ambient>
            <diffuse>0.8 0.8 0.82 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Perimeter LIDAR-Reflective Boundary Walls (30m x 30m Footprint) -->
    <!-- North Wall -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 15 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>30.4 0.4 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>30.4 0.4 2.0</size></box></geometry>
          <material><ambient>0.3 0.35 0.4 1</ambient><diffuse>0.3 0.35 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- South Wall -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -15 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>30.4 0.4 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>30.4 0.4 2.0</size></box></geometry>
          <material><ambient>0.3 0.35 0.4 1</ambient><diffuse>0.3 0.35 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- East Wall -->
    <model name="wall_east">
      <static>true</static>
      <pose>15 0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 30.4 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 30.4 2.0</size></box></geometry>
          <material><ambient>0.3 0.35 0.4 1</ambient><diffuse>0.3 0.35 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- West Wall -->
    <model name="wall_west">
      <static>true</static>
      <pose>-15 0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 30.4 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 30.4 2.0</size></box></geometry>
          <material><ambient>0.3 0.35 0.4 1</ambient><diffuse>0.3 0.35 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Start Zone (A) Marker -->
    <model name="zone_a_marker">
      <static>true</static>
      <pose>-12 -12 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>1.5</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.1 0.8 0.2 0.8</ambient><diffuse>0.1 0.8 0.2 0.8</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Goal Zone (B) Marker -->
    <model name="zone_b_marker">
      <static>true</static>
      <pose>12 12 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>1.5</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.9 0.1 0.1 0.8</ambient><diffuse>0.9 0.1 0.1 0.8</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================== -->
    <!-- DUAL-PATH TOPOLOGY 1: Direct Incline Ramp (3D)  -->
    <!-- Connects Start region diagonally to Goal summit -->
    <!-- ============================================== -->
    <!-- Ascending Ramp from (-9, -9) to (-2, -2) -->
    <model name="incline_ramp_up">
      <static>true</static>
      <!-- Angle ~ 11.3 degrees (0.2 rad), rising to 1.4m height -->
      <pose>-5.5 -5.5 0.7 0.141 -0.141 -0.785</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8.5 2.5 0.15</size></box></geometry>
          <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>8.5 2.5 0.15</size></box></geometry>
          <material><ambient>0.85 0.65 0.15 1</ambient><diffuse>0.85 0.65 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Elevated Summit Platform at (0, 0, 1.4) -->
    <model name="ramp_summit_platform">
      <static>true</static>
      <pose>0 0 1.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.5 3.5 0.15</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.5 3.5 0.15</size></box></geometry>
          <material><ambient>0.85 0.5 0.1 1</ambient><diffuse>0.85 0.5 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Descending Ramp from (2, 2) to (9, 9) -->
    <model name="incline_ramp_down">
      <static>true</static>
      <pose>5.5 5.5 0.7 -0.141 0.141 -0.785</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8.5 2.5 0.15</size></box></geometry>
          <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>8.5 2.5 0.15</size></box></geometry>
          <material><ambient>0.85 0.65 0.15 1</ambient><diffuse>0.85 0.65 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================== -->
    <!-- DUAL-PATH TOPOLOGY 2: Zig-Zag Ground Floor      -->
    <!-- Static Obstacles: Storage Racks, Pillars & Walls -->
    <!-- ============================================== -->
    <!-- Storage Rack 1 (divides diagonal from zig-zag corridor) -->
    <model name="warehouse_rack_1">
      <static>true</static>
      <pose>-8 -2 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 8.0 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 8.0 2.5</size></box></geometry>
          <material><ambient>0.15 0.3 0.6 1</ambient><diffuse>0.15 0.3 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Storage Rack 2 (creates zig-zag chicane) -->
    <model name="warehouse_rack_2">
      <static>true</static>
      <pose>-2 4 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8.0 1.2 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8.0 1.2 2.5</size></box></geometry>
          <material><ambient>0.15 0.3 0.6 1</ambient><diffuse>0.15 0.3 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Storage Rack 3 (guides ground path around east side) -->
    <model name="warehouse_rack_3">
      <static>true</static>
      <pose>4 -4 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 8.0 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 8.0 2.5</size></box></geometry>
          <material><ambient>0.15 0.3 0.6 1</ambient><diffuse>0.15 0.3 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Storage Rack 4 (corridor near goal zone) -->
    <model name="warehouse_rack_4">
      <static>true</static>
      <pose>8 2 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 8.0 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 8.0 2.5</size></box></geometry>
          <material><ambient>0.15 0.3 0.6 1</ambient><diffuse>0.15 0.3 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Structural Pillars (Narrow chokepoints) -->
    <model name="pillar_1">
      <static>true</static>
      <pose>-12 3 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.45</radius><length>3.0</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.45</radius><length>3.0</length></cylinder></geometry><material><ambient>0.5 0.5 0.5 1</ambient></material></visual>
      </link>
    </model>

    <model name="pillar_2">
      <static>true</static>
      <pose>-4 -8 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.45</radius><length>3.0</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.45</radius><length>3.0</length></cylinder></geometry><material><ambient>0.5 0.5 0.5 1</ambient></material></visual>
      </link>
    </model>

    <model name="pillar_3">
      <static>true</static>
      <pose>6 9 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.45</radius><length>3.0</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.45</radius><length>3.0</length></cylinder></geometry><material><ambient>0.5 0.5 0.5 1</ambient></material></visual>
      </link>
    </model>

    <!-- ============================================== -->
    <!-- DYNAMIC AGENTS: Crossing Pedestrian & AMR       -->
    <!-- ============================================== -->
    <!-- Dynamic Pedestrian Actor crossing the zig-zag corridor -->
    <actor name="pedestrian_crossing">
      <pose>-12 0 0.85 0 0 0</pose>
      <link name="actor_link">
        <collision name="collision">
          <geometry><cylinder><radius>0.3</radius><length>1.7</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>1.7</length></cylinder></geometry>
          <material><ambient>0.9 0.4 0.1 1</ambient><diffuse>0.9 0.4 0.1 1</diffuse></material>
        </visual>
      </link>
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walking">
          <waypoint><time>0</time><pose>-12 -4 0.85 0 0 1.57</pose></waypoint>
          <waypoint><time>8</time><pose>-12 4 0.85 0 0 1.57</pose></waypoint>
          <waypoint><time>9</time><pose>-12 4 0.85 0 0 -1.57</pose></waypoint>
          <waypoint><time>17</time><pose>-12 -4 0.85 0 0 -1.57</pose></waypoint>
          <waypoint><time>18</time><pose>-12 -4 0.85 0 0 1.57</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- Dynamic Secondary Cross-Traffic AMR crossing east corridor -->
    <actor name="cross_traffic_amr">
      <pose>3 0 0.25 0 0 0</pose>
      <link name="amr_link">
        <collision name="collision">
          <geometry><box><size>0.8 0.6 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.6 0.5</size></box></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
      <script>
        <loop>true</loop>
        <delay_start>2.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="1" type="moving">
          <waypoint><time>0</time><pose>0 -1 0.25 0 0 0</pose></waypoint>
          <waypoint><time>6</time><pose>8 -1 0.25 0 0 0</pose></waypoint>
          <waypoint><time>7</time><pose>8 -1 0.25 0 0 3.14</pose></waypoint>
          <waypoint><time>13</time><pose>0 -1 0.25 0 0 3.14</pose></waypoint>
          <waypoint><time>14</time><pose>0 -1 0.25 0 0 0</pose></waypoint>
        </trajectory>
      </script>
    </actor>

  </world>
</sdf>
